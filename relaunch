#!/usr/bin/env bash
# relaunch — orchestrator-level "fresh restart" for registered projects.
#
# For each registered project (or just the one named on the CLI) this:
#   1. tears the whole preview stack DOWN   (docker containers + flutter + tunnels)
#   2. brings it back UP FRESH              (containers recreated, frontend
#                                            recompiled, brand-new cloudflared tunnels)
#   3. POSTS the live URLs — each with the repo + branch + sha behind it — into
#      that project's Telegram forum topic
#
# The per-project mechanics live in each project's own <name>-dev.sh (up/urls);
# relaunch only orchestrates them and routes the resulting URLs to the right
# channel. Topic id + workspace come from the registry — the single source of truth.
#
# --reset additionally drops the backend's docker VOLUMES before bringing it up,
# so the checked-out branch's migration chain replays against an empty database.
# That is the mode a branch switch needs (checkout.py --build passes it): without
# it a "fresh" preview can serve the previous branch's schema and rows out of a
# named volume that survives every restart.
#
# A rebuild that changes nothing is not free: it costs a `down -v` (the seeded dev
# database) plus a ~4-minute release web build, and the checkout flow can ask for
# one minutes after a relaunch already served the same branch at the same commit.
# So each project is asked first (`<name>-dev.sh current`, which compares the
# build watermark against the repos as they stand): already serving these commits
# with a live server = no down, no rebuild, just re-post the URLs. --force skips
# the question and rebuilds regardless.
#
# Usage:  relaunch [--reset] [--force] [project-name]   # no name = every registered project
set -uo pipefail

ORCH_HOME="${AGENT_ORCH_HOME:-$HOME/.agent-orchestrator}"
REGISTRY="$ORCH_HOME/registry.json"
ENV_FILE="$ORCH_HOME/telegram.env"
RESET=0
FORCE=0
FILTER=""
for arg in "$@"; do
  case "$arg" in
    --reset) RESET=1 ;;
    --force) FORCE=1 ;;
    -*)      echo "relaunch: unknown flag $arg" >&2; exit 2 ;;
    *)       FILTER="$arg" ;;
  esac
done
reset_note=""
[ "$RESET" = 1 ] && reset_note=" (backend volumes reset)"

[ -f "$REGISTRY" ] || { echo "relaunch: no registry at $REGISTRY" >&2; exit 1; }

# Telegram creds (chat id + bot token) for posting; the per-project topic id is
# read from the registry below. All optional — missing creds means "print only".
# shellcheck disable=SC1090
[ -f "$ENV_FILE" ] && . "$ENV_FILE"

post() { # topic_id text
  local topic="$1" text="$2"
  echo "[relaunch] -> topic $topic: $text"
  if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
    echo "[relaunch] (no telegram creds; printed only)"; return
  fi
  curl -fsS "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
    --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
    --data-urlencode "message_thread_id=$topic" \
    --data-urlencode "text=$text" >/dev/null \
    || echo "[relaunch] telegram send failed for topic $topic" >&2
}

# Emit "topic<TAB>name<TAB>workspace" rows from the registry (optionally filtered).
rows() {
  python3 - "$REGISTRY" "$FILTER" <<'PY'
import json, sys
reg = json.load(open(sys.argv[1]))
flt = sys.argv[2]
for topic, e in reg.items():
    if flt and e.get("name") != flt:
        continue
    print(f"{topic}\t{e['name']}\t{e['workspace']}")
PY
}

any=0
while IFS=$'\t' read -r topic name workspace; do
  any=1
  root="$(dirname "$workspace")"                       # workspace = <root>/intentpipe
  dev="$(ls "$root"/*-dev.sh 2>/dev/null | head -1)"
  echo "=============================================================="
  echo "[relaunch] $name  (topic $topic, root $root)"
  if [ -z "$dev" ]; then
    echo "[relaunch] no *-dev.sh in $root — skipping"
    post "$topic" "⚠️ $name: no dev script found, cannot relaunch."
    continue
  fi

  # Redirect to a FILE, never $(...): the dev scripts launch a long-lived static
  # web server in the background, and command substitution would block on its
  # still-open pipe forever.
  uplog="$(mktemp)"
  # Ask BEFORE the destructive part: `down` would itself kill the server this
  # check needs to find alive, and `down -v` the database it protects.
  skipped=0
  if [ "$FORCE" != 1 ] && ( cd "$root" && bash "$dev" current >/dev/null 2>&1 ); then
    skipped=1
    echo "[relaunch] $name already serves the checked-out commits and is up — no rebuild"
    ( cd "$root" && bash "$dev" urls ) >"$uplog" 2>&1
  else
    echo "[relaunch] down ..."
    ( cd "$root" && bash "$dev" down ) || echo "[relaunch] down reported errors (continuing)"

    # The dev scripts stop the flutter *wrapper* pid, but the web server runs as a
    # forked child that survives `down` and keeps squatting its port — which then
    # blocks the fresh build from binding (and leaves a stale build serving). Free
    # the frontend port explicitly. Port is discovered from the dev script itself.
    fport="$(grep -oE 'web-port[= "]+[0-9]+|FRONTEND_PORT=[0-9]+' "$dev" | grep -oE '[0-9]+' | head -1)"
    if [ -n "$fport" ]; then
      for p in $(ss -tlnpH "sport = :$fport" 2>/dev/null | grep -oE 'pid=[0-9]+' | grep -oE '[0-9]+' | sort -u); do
        echo "[relaunch] freeing stale listener on :$fport (kill $p)"; kill "$p" 2>/dev/null || true
      done
      sleep 1
    fi

    echo "[relaunch] up (backend$reset_note) + fresh frontend build ..."
    # A file redirect returns as soon as the commands finish; `timeout` is only a
    # backstop in case a dev script itself wedges.
    # One `up` is enough: preview-lib's up starts the backend and ALWAYS recompiles
    # the frontend before serving it. (It used to be `rebuild && up`, from before
    # that guarantee existed — which paid for the ~80s release build twice.)
    # BACKEND_RESET_VOLUMES is read by preview-lib's start_backend; PREVIEW_FORCE_
    # REBUILD makes `up` rebuild even when its watermark says it needn't.
    BACKEND_RESET_VOLUMES="$RESET" PREVIEW_FORCE_REBUILD="$FORCE" \
      timeout 600 bash -c 'cd "$1" && bash "$2" up' _ "$root" "$dev" >"$uplog" 2>&1 \
      || echo "[relaunch] up did not exit cleanly (see below)"
  fi
  cat "$uplog"

  # Every dev script's `urls` tags its frontend line with "(static release" (and
  # never the API line), but the label differs per project — tyf prints
  # "App (Flutter web) : <url>", bibbles prints "Frontend : <url>" — so keying on
  # "(Flutter web)" silently missed bibbles. Match the shared "static release"
  # marker instead. Persistent named tunnel: the URL is the fixed
  # https://<name>.<domain> (was an ephemeral *.trycloudflare.com), so match any https host.
  url="$(grep -i 'static release' "$uplog" | grep -oE 'https://[A-Za-z0-9.-]+' | head -1)"
  # The whole URL block from the LAST `urls` print — each URL with the repo,
  # branch and sha it is serving (and a MIXED CHECKOUT warning when the two repos
  # disagree). Posting it verbatim is what makes "which branch am I looking at?"
  # answerable from the phone, instead of a bare link that could be anything.
  block="$(awk '/^=== Preview URLs/ {buf = ""} {if (buf != "" || /^=== Preview URLs/) buf = buf $0 "\n"} END {printf "%s", buf}' "$uplog")"
  rm -f "$uplog"

  if [ -z "$url" ]; then
    echo "[relaunch] WARNING: no frontend URL captured for $name" >&2
    post "$topic" "⚠️ $name relaunched but the frontend URL wasn't captured — check the server."
    continue
  fi
  echo "[relaunch] $name frontend: $url"
  if [ "$skipped" = 1 ]; then
    post "$topic" "✅ $name is already up to date — nothing rebuilt (relaunch --force to rebuild anyway)

$block"
  else
    post "$topic" "🚀 $name relaunched$reset_note

$block"
  fi
done < <(rows)

[ "$any" = 1 ] || { echo "relaunch: no matching project${FILTER:+ \"$FILTER\"}" >&2; exit 1; }
echo "[relaunch] done."
