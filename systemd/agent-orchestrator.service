# Inbound Telegram daemon, always-on. Install per README:
#   cp intentpipe/orchestrator/systemd/agent-orchestrator.service ~/.config/systemd/user/
#   (edit User/paths below if not running as a user unit)
#   systemctl --user enable --now agent-orchestrator
# Secrets stay in ~/.agent-orchestrator/telegram.env (chmod 600), never here.
[Unit]
Description=Server Telegram inbound orchestrator (voice/text control plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Only kill the daemon itself on stop/restart — NOT its detached children. The
# default (control-group) SIGKILLs the whole cgroup, which would abort an in-flight
# plan/loop/relaunch every time the daemon restarts.
KillMode=process
# claude (and other user-installed tools) live in ~/.local/bin, which the systemd
# service PATH omits — add it so the daemon can spawn `claude` for 🧠/🚀/General.
Environment=PATH=%h/.local/bin:/opt/flutter/bin:/usr/local/bin:/usr/bin:/bin
# %h = the running user's home. Adjust if the checkout lives elsewhere.
ExecStart=%h/intentpipe/orchestrator/daemon.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
