# Inbound Telegram daemon, always-on. Install per README:
#   cp intentpipe/orchestrator/systemd/agent-orchestrator.service ~/.config/systemd/user/
#   (edit User/paths below if not running as a user unit)
#   systemctl --user enable --now agent-orchestrator
# Secrets stay in ~/.agent-orchestrator/telegram.env (chmod 600), never here.
[Unit]
Description=Server Telegram inbound orchestrator (voice/text control plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Take the detached children down WITH the daemon. Sparing them (KillMode=process)
# kept an in-flight plan/loop alive across a restart, but the new daemon had no
# handle on it: systemd logged "Unit process 1424274 (python3) remains running
# after unit stopped" and then "Found left-over process 3914986 (python3) in
# control group while starting unit" for the SAME pid across three restarts, while
# the orphan kept writing to the workspace. An aborted run the user is told about
# beats a second run touching the same repo. TERM first so claude can finish its
# turn and flush, KILL only for whatever is still there after TimeoutStopSec.
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
TimeoutStopSec=30
# claude (and other user-installed tools) live in ~/.local/bin, which the systemd
# service PATH omits — add it so the daemon can spawn `claude` for 🧠/🚀/General.
Environment=PATH=%h/.local/bin:/opt/flutter/bin:/usr/local/bin:/usr/bin:/bin
# A systemd user unit never sources ~/.bashrc, so the interactive shell's
# CLAUDE_CODE_OAUTH_TOKEN export never reached spawned `claude` children —
# they fell back to the on-disk credentials, whose refresh token had gone
# stale (2026-08-08, quorum loop: "OAuth session expired and could not be
# refreshed" on every headless run). subprocess.Popen inherits the daemon's
# environment, so setting it here covers every spawned claude/loop.sh.
EnvironmentFile=%h/.agent-orchestrator/claude-auth.env
# %h = the running user's home. Adjust if the checkout lives elsewhere.
ExecStart=%h/intentpipe/orchestrator/daemon.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
